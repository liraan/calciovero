+            man,
+            (v0, self.ground_keep),
+            &players,
+            thought.forecast_step_cm,
+        );
+        match forecast.first {
+            Some(first) if players[first].mate => thought.confidence(forecast.margin),
+            Some(_) => thought.confidence(-forecast.margin),
+            None => 0.0,
+        }
+    }
