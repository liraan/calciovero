#!/bin/sh
# Pre-push gate: runs process/scripts/gates.sh before any push.
# Exit non-zero to block the push.
#
# Bypass: `git push --no-verify` (documented, not recommended).
# In phase 2 this is replaced by the ruleset + CI on GitHub (server-side,
# not bypassable). See process/AGENT-POLICY.md and IDEA-INFRA-010.

set -u

# OI-66: gates.sh reads the working tree, not HEAD. A dirty tree can pass
# locally and push a commit that no gate has verified. Require a clean
# tree relative to HEAD before running the gate.
if ! git diff --quiet HEAD 2>/dev/null; then
  echo "" >&2
  echo "pre-push: working tree is dirty (uncommitted changes to tracked files)." >&2
  echo "pre-push: gates.sh reads the working tree, not HEAD; a dirty tree can pass" >&2
  echo "pre-push: locally and push a commit that no gate has verified (OI-66)." >&2
  echo "pre-push: commit or stash the changes, then push." >&2
  exit 1
fi

if [ ! -f process/scripts/gates.sh ]; then
  echo "pre-push: process/scripts/gates.sh not found" >&2
  exit 1
fi

if bash process/scripts/gates.sh closing; then
  exit 0
else
  echo "" >&2
  echo "pre-push: gates RED - push blocked." >&2
  echo "pre-push: fix the failures above, or bypass with --no-verify (not recommended)." >&2
  exit 1
fi
