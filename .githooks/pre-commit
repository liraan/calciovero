#!/bin/sh
# Pre-commit hook: runs cargo fmt, clippy, test only if Rust files are staged.
# Install once with: git config core.hooksPath .githooks

set -e

staged_rust=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(\.rs$|^Cargo\.toml$|^Cargo\.lock$|^rust-toolchain\.toml$)' || true)

if [ -z "$staged_rust" ]; then
  echo "pre-commit: no Rust files staged, skipping cargo checks."
  exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: Rust files are staged but 'cargo' is not in PATH. Aborting." >&2
  exit 1
fi

echo "pre-commit: Rust files staged:"
echo "$staged_rust" | sed 's/^/  /'

# The checks live in session.sh; the hook only calls the modules, so there is
# no second list of commands to keep in sync (OI-130).
echo "pre-commit: check fmt..."
bash context/scripts/session.sh check fmt

echo "pre-commit: check clippy..."
bash context/scripts/session.sh check clippy

# The script reads the staged crates and runs their tests only; a touched
# core crate (or Cargo.toml/lock) switches it to the full suite.
echo "pre-commit: check changed (staged)..."
bash context/scripts/session.sh check changed staged

echo "pre-commit: all checks passed."
