#!/bin/sh
# Validates closing-commit trailers per NEW-SESSION-PROMPT.md §G.
# Uses `git interpret-trailers --parse`, the same parser as `git log --format`.
# The hook fires when SESSION-STATE.md is staged (closing commit), not by subject.

MSG="$1"

# Direction-Check (2026-11-02): a commit that touches a direction file
# (IDEAS.md, WORLD-MODEL.md) must carry a `Direction-Check:` trailer.
# The judgment is not mechanised; the artefact is (a missing trailer is
# a red hook, a false "none" is a D1 violation visible in git log).
msg_trailers=$(git interpret-trailers --parse < "$MSG")
dir_staged=$(git diff --cached --name-only | grep -E '^docs/context/IDEAS\.md$|^docs/WORLD-MODEL\.md$' || true)
if [ -n "$dir_staged" ]; then
  echo "$msg_trailers" | grep -qE '^Direction-Check:' || { echo "commit-msg: direction file staged ($(echo "$dir_staged" | tr '\n' ' ')); missing 'Direction-Check:' trailer" >&2; exit 1; }
fi

if ! git diff --cached --name-only | grep -qx 'docs/context/SESSION-STATE.md'; then
  exit 0
fi


# S1 on every bookmark update: the staged SESSION-STATE.md must point
# `Last commit verified` to the commit before this one, i.e. current HEAD.
# A commit that touches the bookmark without updating the field leaves it
# partially inconsistent (E4).
staged_lcv=$(git show :docs/context/SESSION-STATE.md 2>/dev/null | grep -oE 'Last commit verified:\*\* `[0-9a-f]{7,40}`' | grep -oE '[0-9a-f]{7,40}')
head_short=$(git rev-parse --short HEAD)
if [ -z "$staged_lcv" ]; then
  echo "commit-msg: SESSION-STATE.md staged but 'Last commit verified' not found" >&2
  exit 1
fi
case "$staged_lcv" in
  "$head_short"*) : ;;
  *) echo "commit-msg: 'Last commit verified' ($staged_lcv) does not match HEAD ($head_short); S1 applies to every bookmark update (E4)" >&2; exit 1 ;;
esac
trailers=$msg_trailers


# Redundancy guard (2026-11-01): the bookmark must not duplicate `git log`.
# `Files touched` and `Done (storico)` were removed from §F because both are
# already in `git log --stat` and `git log --oneline`. A future edit that
# reintroduces them is caught here, not at the closing ritual.
staged_ss=$(git show :docs/context/SESSION-STATE.md 2>/dev/null)
if echo "$staged_ss" | grep -qE '^\*\*Files touched this session'; then
  echo "commit-msg: SESSION-STATE.md contains 'Files touched this session'; it duplicates git log (see NEW-SESSION-PROMPT.md §F)" >&2
  exit 1
fi
if echo "$staged_ss" | grep -qE '^\*\*Done \(storico\)'; then
  echo "commit-msg: SESSION-STATE.md contains 'Done (storico)'; it duplicates git log (see NEW-SESSION-PROMPT.md §F)" >&2
  exit 1
fi
# Rule changes require a non-skipped Rules-Audit trailer.
if git diff --cached --name-only | grep -qx 'docs/context/NEW-SESSION-PROMPT.md'; then
  if echo "$trailers" | grep -qE '^Rules-Audit:[[:space:]]*skipped'; then
    echo "commit-msg: NEW-SESSION-PROMPT.md changed; Rules-Audit: skipped is not allowed" >&2
    exit 1
  fi
  echo "$trailers" | grep -qE '^Rules-Audit:' || { echo "commit-msg: NEW-SESSION-PROMPT.md changed; missing 'Rules-Audit:' trailer" >&2; exit 1; }
fi


echo "$trailers" | grep -qE '^Verified:'     || { echo "commit-msg: missing 'Verified:' trailer (exact case, at line start)" >&2; exit 1; }

exit 0
